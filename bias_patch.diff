+// Splits "a=1&b=2&c=3" into key/value pairs
+static void parseQueryString(const char *qs, KVPairs &kv) {
+    kv.num_pairs = 0;
+    while (kv.num_pairs < NUM_KEY_VALUES && *qs) {
+        const char *eq = strchr(qs, '=');
+        if (!eq) break;
+        int keylen = eq - qs;
+        strncpy(kv.keys[kv.num_pairs], qs, keylen);
+        kv.keys[kv.num_pairs][keylen] = '\0';
+
+        const char *amp = strchr(eq+1, '&');
+        int vallen = amp ? (amp - (eq+1)) : strlen(eq+1);
+        strncpy(kv.values[kv.num_pairs], eq+1, vallen);
+        kv.values[kv.num_pairs][vallen] = '\0';
+
+        kv.num_pairs++;
+        if (!amp) break;
+        qs = amp + 1;
+    }
+}
+
 // … all your existing JSONXXX, ServeHeader, etc. stay exactly as-is …

@@ -852,14 +870,41 @@ void web::ProcessWebClients()
     EthernetClient client = m_server->available();
     if (!client) return;

-    if (!ParseHTTPHeader(client, &key_value_pairs, sPage, sizeof(sPage))) {
-        trace(F("ERROR!\n"));
-        ServeError(pFile);
-    } else {
-        trace(F("Page:%s\n"), sPage);
+    //
+    // 1) Read just the first request‐line (up through '\\n')
+    //
+    char requestLine[256] = {0};
+    size_t idx = 0;
+    uint8_t b;
+    while (idx < sizeof(requestLine)-1 && client.read(&b,1) == 1) {
+        requestLine[idx++] = b;
+        if (b == '\n') break;
+    }
+    requestLine[idx] = '\0';
+
+    //
+    // 2) Drain remaining headers up to a blank line
+    //
+    while (client.connected() && client.read(&b,1) == 1) {
+        if (b == '\n') break;
+    }
+
+    //
+    // 3) Split path vs. query string
+    //
+    char *sp1 = strchr(requestLine, ' ');
+    if (!sp1) { client.stop(); return; }
+    char *sp2 = strchr(sp1+1, ' ');
+    int pathLen = sp2 ? (sp2 - (sp1+1)) : strlen(sp1+1);
+    char sPage[64] = {0};
+    if (pathLen >= (int)sizeof(sPage)) pathLen = sizeof(sPage)-1;
+    memcpy(sPage, sp1+1, pathLen);
+    sPage[pathLen] = '\0';
+
+    //
+    // 4) Parse the '?' query-string into key_value_pairs
+    //
+    KVPairs key_value_pairs = {0};
+    if (char *q = strchr(sPage, '?')) {
+        *q = '\0';
+        parseQueryString(q+1, key_value_pairs);
+    }
+
+    trace(F("Page: %s\n"), sPage);
+
+    // 5) Now dispatch exactly as you did before, but your bias_temp, bias_humid
+    //    and bias_rain will all be present in key_value_pairs.
+
     // … rest of your bin/... and json/... branches unchanged …
+
     fflush(pFile);
     fclose(pFile);
     client.stop();
 }
